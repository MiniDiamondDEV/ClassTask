td{border:1px solid #ccc;padding:8px;vertical-align:top}
tr:nth-child(even) td{background:#fafafa}
.pill{display:inline-block;padding:2px 6px;border:1px solid #bbb;background:#eee;font-size:11px;border-radius:10px;white-space:nowrap}
.pill.green{background:#e6f2e3;border-color:#9cbc91}
.pill.red{background:#f7e5e3;border-color:#d1a09b}
