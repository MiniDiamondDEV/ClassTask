#app{max-width:1220px;margin:18px auto;padding:0 12px}
.layout{display:grid;grid-template-columns:220px minmax(0,1fr);gap:16px}
.sidebar{background:#f8f8f8;border:1px solid #bbb;align-self:start}
.sideTitle{background:#e2e7eb;border-bottom:1px solid #bbb;padding:10px;font-weight:bold}
.sideNav button{width:100%;display:block;text-align:left;border:0;border-bottom:1px solid #ddd;background:#fff;padding:9px 10px;color:#174f80}
.sideNav button:hover,.sideNav button.active{background:#eaf2f8;color:#111;font-weight:bold}
.content{min-width:0}
.panel{background:#fff;border:1px solid #b8b8b8;margin-bottom:16px;box-shadow:0 1px 2px rgba(0,0,0,.06)}
