function submissionsFor(aid,studentId=state.profile.studentId){return state.submissions.filter(s=>s.assignmentId===aid&&s.studentId===studentId&&s.status==="submitted").sort((x,y)=>new Date(y.submittedAt)-new Date(x.submittedAt))}
