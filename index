.panelHead h1,.panelHead h2,.panelHead h3{font-size:16px;margin:0}
.panelBody{padding:14px}
.toolbar{display:flex;align-items:center;gap:6px;flex-wrap:wrap;margin-bottom:12px}
.btn{display:inline-block;border:1px solid #9d9d9d;background:linear-gradient(#fff,#e6e6e6);color:#222;padding:7px 10px;border-radius:2px;box-shadow:inset 0 1px 0 #fff}
.btn:hover{background:#f2f2f2;text-decoration:none}
.btn.primary{background:linear-gradient(#4e82b2,#2d5d8a);border-color:#234f75;color:#fff}
.btn.success{background:linear-gradient(#6fa05e,#4d7e3f);border-color:#3d6d31;color:#fff}
.btn.danger{background:linear-gradient(#c75c55,#a43d36);border-color:#8d302b;color:#fff}
.btn.warn{background:linear-gradient(#e3b95b,#c8942d);border-color:#aa7b24;color:#2f2412}
.btn.small{padding:4px 7px;font-size:12px}
