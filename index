function findBlock(aid,bid){const a=findAssignment(aid);return [a,a?.blocks.find(b=>b.id===bid)]}
function effectivePoints(b){return (Number(b.points)||0)*(Number(b.weight)||1)}
function rawPoints(a){return (a.blocks||[]).reduce((s,b)=>s+(Number(b.points)||0),0)}
function weightedPoints(a){return (a.blocks||[]).reduce((s,b)=>s+effectivePoints(b),0)}
