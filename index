function importJSONWork(obj,name){
  if(obj.type==="classtask-assignment"&&obj.assignment){const a=migrateState({assignments:[obj.assignment]}).assignments[0];a.id=uid("asn");a.title+=" (Imported)";a.status="draft";state.assignments.push(a);saveState();go("builder",{id:a.id});return}
  if(obj.assignments&&Array.isArray(obj.assignments)){obj.assignments.forEach(src=>{const a=JSON.parse(JSON.stringify(src));a.id=uid("asn");a.title=(a.title||"Imported Assignment")+" (Imported)";a.status="draft";a.blocks=(a.blocks||[]).map(b=>Object.assign({},b,{id:uid("b"),weight:Number(b.weight||1)}));state.assignments.push(a)});saveState();go("assignments");toast("Assignments imported as drafts.");return}
  createDraftFromText(name.replace(/\.[^.]+$/,""),JSON.stringify(obj,null,2));
}
function parseCSVLine(line){
  const out=[];let cur="",q=false;
  for(let i=0;i<line.length;i++){const ch=line[i];if(ch==='"'){if(q&&line[i+1]==='"'){cur+='"';i++}else q=!q}else if(ch===","&&!q){out.push(cur);cur=""}else cur+=ch}out.push(cur);return out;
}
function importCSVWork(text,name){
  const rows=text.split(/\r?\n/).filter(Boolean).map(parseCSVLine);if(!rows.length)return;
  const hdr=rows[0].map(x=>x.trim().toLowerCase()),blocks=[];
  rows.slice(1).forEach(r=>{const o={};hdr.forEach((h,i)=>o[h]=r[i]||"");const type=(o.type||"long").toLowerCase();
    if(type.includes("multiple")){const choices=[o.choice1,o.choice2,o.choice3,o.choice4].filter(Boolean),answer=Math.max(0,choices.findIndex(x=>x===o.answer));blocks.push({id:uid("b"),type:"multiple",prompt:o.prompt||o.question||"",choices,answer:answer<0?0:answer,points:Number(o.points)||1,weight:Number(o.weight)||1,required:true})}
    else blocks.push({id:uid("b"),type:type.includes("short")?"short":"long",prompt:o.prompt||o.question||r.join(" "),teacherKey:o.answer||"",points:Number(o.points)||1,weight:Number(o.weight)||1,required:true});
  });
  const title=name.replace(/\.[^.]+$/,"");const a={id:uid("asn"),classId:state.classes[0]?.id||"",unitId:state.units[0]?.id||"",title,description:"Imported from CSV. Review answers, points, and weights before publishing.",instructions:"",category:"Assignment",status:"draft",createdAt:nowISO(),updatedAt:nowISO(),dueAt:"",settings:{attempts:1,shuffleQuestions:false,shuffleChoices:false,releaseMode:"teacher",showCorrect:false,showFeedback:true,allowLate:true,tts:false,requireAll:true,timerMinutes:0,navigation:"sequential",gradingMode:"autograde",aiChecker:false,showPublicComments:true,testMode:false,fullscreenRequired:true,lockOnFullscreenExit:true},blocks};state.assignments.push(a);saveState();go("builder",{id:a.id});
}

