function confirmDeleteClass(id){
  const c=state.classes.find(x=>x.id===id);if(!c)return;
  const unitIds=new Set(state.units.filter(u=>u.classId===id).map(u=>u.id));
  const deleteAssignmentIds=new Set();
  state.assignments.forEach(a=>{
    const ids=assignmentClassIds(a);
    if(!ids.includes(id))return;
    const left=ids.filter(x=>x!==id);
    if(!left.length)deleteAssignmentIds.add(a.id);
    else{a.classIds=left;a.classId=left[0];if(unitIds.has(a.unitId))a.unitId=""}
  });
  state.units=state.units.filter(u=>u.classId!==id);
  state.assignments=state.assignments.filter(a=>!deleteAssignmentIds.has(a.id));
  state.submissions=state.submissions.filter(s=>!deleteAssignmentIds.has(s.assignmentId));
  state.publicComments=state.publicComments.filter(cmt=>!deleteAssignmentIds.has(cmt.assignmentId));
  state.commands=state.commands.filter(cmd=>!deleteAssignmentIds.has(cmd.assignmentId));
  state.profile.classIds=(state.profile.classIds||[]).filter(x=>x!==id);
  state.classes=state.classes.filter(x=>x.id!==id);
  logActivity(`Deleted class: ${c.name} and cleaned related data.`);saveState();closeModal();render();toast("Class deleted.");
}
