function aiReview(text){
  const words=(text.toLowerCase().match(/[a-z0-9']+/g)||[]),unique=new Set(words),sentences=(text.match(/[.!?]+/g)||[]).length||1;
  const diversity=words.length?unique.size/words.length:0;
  const phraseHits=["in conclusion","furthermore","moreover","it is important to note","overall"].filter(p=>text.toLowerCase().includes(p)).length;
  let signal=0;
  if(words.length>120&&diversity<.43)signal+=25;
  if(words.length>180)signal+=10;
  if(phraseHits>=2)signal+=18;
  if(words.length/sentences>28)signal+=15;
  if(words.length>60&&/[—;]/.test(text))signal+=5;
  signal=clamp(signal,0,80);
  return {signal,words:words.length,diversity,phraseHits,label:signal>=50?"Review suggested":signal>=25?"Some review signals":"Low heuristic signal"};
}
