function activeTestDraft(){
  if(state.role!=="student"||route!=="take")return null;
  const a=findAssignment(routeData.id),s=a?currentDraft(a.id):null;
  return a&&s&&a.settings.testMode&&s.status==="draft"?{a,s}:null;
}
function recordIntegrityEvent(type,detail,lock=false){
  const ctx=activeTestDraft();if(!ctx)return;
  const {a,s}=ctx;
  s.integrityEvents=s.integrityEvents||[];
  const last=s.integrityEvents[s.integrityEvents.length-1];
  if(last&&last.type===type&&Date.now()-new Date(last.time).getTime()<1500)return;
  s.integrityEvents.push({id:uid("int"),type,time:nowISO(),page:Number(s.currentPage||0),detail});
  if(lock&&a.settings.lockOnFullscreenExit){
    s.integrityStatus="pending_review";s.locked=true;s.lockReason=type;s.lockPage=Number(s.currentPage||0);s.lockStartedAt=nowISO();
    logActivity(`Integrity review: ${s.studentName} exited fullscreen during ${a.title} at page ${Number(s.currentPage||0)+1}.`);
    saveState();render();toast("Test Mode paused for teacher review.");
  }else scheduleSave();
}
document.addEventListener("fullscreenchange",()=>{
  const ctx=activeTestDraft();if(!ctx)return;
  if(ctx.a.settings.fullscreenRequired&&!document.fullscreenElement)recordIntegrityEvent("fullscreen_exit","Fullscreen was exited while the Test Mode attempt was active.",true);
});
document.addEventListener("visibilitychange",()=>{
  const ctx=activeTestDraft();if(ctx&&document.hidden)recordIntegrityEvent("tab_hidden","The test page became hidden or the student switched away from it.",false);
});

window.addEventListener("beforeunload",()=>saveState());
importHashShare();
render();
if(location.hash.startsWith("#cloud="))setTimeout(importCloudHash,0);
