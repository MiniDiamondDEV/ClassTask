.richEditor{border:1px solid #999;background:#fff}
.richTools{background:#eee;border-bottom:1px solid #aaa;padding:5px;display:flex;gap:4px;flex-wrap:wrap}
.richTools button{border:1px solid #aaa;background:#fff;min-width:28px;padding:4px}
.richArea{min-height:42px;padding:8px;outline:none}
.richArea.long{min-height:190px}
.progressBar{height:16px;border:1px solid #999;background:#eee;position:relative;overflow:hidden}
.progressBar div{height:100%;background:#668eb2;width:0}
.progressTiny{height:10px;border:1px solid #aaa;background:#f2f2f2}
.progressTiny div{height:100%;background:#6b8e5f}
.gradeBig{font-size:36px;font-weight:bold;color:#2d5d8a}
.commentBox{border-left:4px solid #9ab3c7;background:#f4f7f9;padding:10px}
.settingsCats{display:grid;grid-template-columns:190px 1fr;gap:12px}
.settingsMenu button{width:100%;text-align:left;border:1px solid #bbb;border-bottom:0;background:#f7f7f7;padding:8px}
.settingsMenu button:last-child{border-bottom:1px solid #bbb}
.settingsMenu button.active{background:#2d5d8a;color:#fff}
.footer{border-top:1px solid #bbb;background:#f5f5f5;color:#666;margin-top:28px}
.footerInner{max-width:1220px;margin:0 auto;padding:18px 12px;font-size:12px;display:flex;justify-content:space-between;gap:15px;flex-wrap:wrap}
.footerLinks a{margin-left:14px}
.modalBack{position:fixed;inset:0;background:rgba(0,0,0,.45);display:flex;align-items:center;justify-content:center;padding:18px;z-index:40}
.modal{background:#fff;border:1px solid #444;width:min(760px,100%);max-height:90vh;overflow:auto;box-shadow:0 5px 30px rgba(0,0,0,.45)}
.modal.wide{width:min(1000px,100%)}
.modalTitle{font-weight:bold;padding:11px 13px;border-bottom:1px solid #bbb;background:#e9edf1}
.modalBody{padding:14px}
.modalFoot{border-top:1px solid #ccc;background:#f4f4f4;padding:10px 14px;display:flex;justify-content:flex-end;gap:7px}
.hidden{display:none!important}
.muted{color:#777}
.right{text-align:right}
.center{text-align:center}
.w100{width:100%}
.mb0{margin-bottom:0}
.mt8{margin-top:8px}
#toast{position:fixed;right:14px;bottom:14px;max-width:340px;background:#222;color:#fff;padding:10px 12px;box-shadow:0 2px 8px rgba(0,0,0,.35);z-index:80;display:none}
.unitBox{border:1px solid #aaa;background:#fff;margin-bottom:12px}
.unitBox summary{cursor:pointer;padding:11px;background:#e9edf1;font-weight:bold;list-style:none}
.unitBox summary::-webkit-details-marker{display:none}
.unitMeta{padding:8px 11px;border-top:1px solid #ccc;background:#fafafa}
.unitTasks{padding:0 11px 11px}
.taskRow{display:grid;grid-template-columns:minmax(0,1fr) 150px 90px 110px;gap:8px;align-items:center;padding:8px 0;border-bottom:1px solid #ddd}
.chart{display:flex;align-items:flex-end;gap:8px;height:165px;padding:10px 8px 0;border-left:1px solid #aaa;border-bottom:1px solid #aaa;background:#fafafa}
.chartCol{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:100%;min-width:35px}
.chartBar{width:70%;min-height:2px;background:#5f83a3;border:1px solid #456985}
.chartLabel{font-size:11px;color:#666;margin-top:5px;white-space:nowrap}
.chartValue{font-size:11px;margin-bottom:3px}
.rosterRow{display:grid;grid-template-columns:minmax(150px,1.3fr) 100px 110px 110px 110px minmax(180px,1fr);gap:7px;padding:8px;border-bottom:1px solid #ddd;align-items:center}
.rosterHead{background:#e9edf1;font-weight:bold;border:1px solid #bbb}
.attemptTimeline{border-left:3px solid #a9b8c4;margin:8px 0;padding-left:12px}
.attemptItem{margin:0 0 10px}
.timerBox{font-weight:bold;border:1px solid #b38428;background:#fff3d2;padding:7px 10px;display:inline-block}
.timerBox.danger{background:#f8dddd;border-color:#b14a42;color:#8a2722}
.startCard{border:1px solid #aeb9c2;background:#fff;padding:18px}
.startDescription{font-size:15px;line-height:1.5;background:#f7f7f7;border:1px solid #ccc;padding:12px;white-space:pre-wrap}
.commentThread{border:1px solid #bbb;background:#fff;margin-bottom:10px}
.commentHead{background:#eee;border-bottom:1px solid #ccc;padding:7px 9px;font-size:12px}
.commentBody{padding:9px;white-space:pre-wrap}
.commandBanner{border:1px solid #8fa4b3;background:#edf5fa;padding:10px;margin-bottom:10px}
.whatsnew{border-left:5px solid #2d5d8a;padding-left:14px;margin-bottom:22px}
.whatsnew h2{margin:0 0 5px;font-size:18px}
.whatsnew ul{margin-top:7px}
.importDrop{border:2px dashed #999;background:#fafafa;padding:28px;text-align:center}
.aiSignal{border:1px solid #bbb;background:#fafafa;padding:10px}
.aiMeter{height:12px;border:1px solid #aaa;background:#eee;margin-top:6px}
.aiMeter div{height:100%;background:#8f7d56}
.smallNote{font-size:11px;color:#666}
.weightTag{font-size:11px;background:#ece7f2;border:1px solid #b8aac6;padding:2px 5px}

.audienceBox{border:1px solid #aaa;background:#fafafa;padding:9px;max-height:150px;overflow:auto}
.audienceBox label{display:block;font-weight:normal;margin:4px 0}
.integrityBadge{display:inline-block;padding:3px 7px;border:1px solid #999;font-size:11px;font-weight:bold}
.integrityBadge.good{background:#e6f2e3;border-color:#7ea674;color:#275a20}
.integrityBadge.warn{background:#fff2cc;border-color:#c9a648;color:#6a4d00}
.integrityBadge.bad{background:#f8dddd;border-color:#b45e58;color:#851f19}
.integrityBadge.pending{background:#e8eef7;border-color:#849bb8;color:#29496d}
.integrityPanel{border:2px solid #b58a31;background:#fff9e8;padding:12px;margin-bottom:12px}
.integrityPanel.bad{border-color:#a8433e;background:#fff0ef}
.fullscreenGate{text-align:center;border:2px solid #315d83;background:#eef6fb;padding:24px}
.analyticsGrid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.analyticsCard{border:1px solid #bbb;background:#fafafa;padding:10px}
.analyticsCard strong{display:block;font-size:20px;color:#2d5d8a}
.integrityEvent{border-left:4px solid #c49b43;background:#fff9e8;padding:8px;margin:6px 0}
.integrityEvent.bad{border-color:#b14943;background:#fff0ef}
.classAudienceLine{font-size:12px;color:#555;margin-top:4px}

@media(max-width:900px){
 .layout{grid-template-columns:1fr}
 .sidebar{display:none}
 .headerNav{display:none}
 .builderTop,.grid2,.grid3,.grid4,.settingsCats{grid-template-columns:1fr}
 .headerRight .roleBadge{display:none}
 .headerInner{min-height:50px}
 .taskRow,.rosterRow,.analyticsGrid{grid-template-columns:1fr}
 .chart{overflow-x:auto}
}
</style>
</head>
<body>
<header id="siteHeader">
  <div class="headerInner">
    <a class="brand" href="#" onclick="go('dashboard');return false"><span class="logoMark"></span>ClassTask</a>
    <div class="headerNav" id="headerNav"></div>
    <div class="headerRight">
      <span class="roleBadge" id="roleBadge">Teacher View</span>
      <button onclick="toggleRole()" id="roleSwitch"><span class="material-icons">swap_horiz</span> Student View</button>
      <button onclick="go('settings')"><span class="material-icons">settings</span> Settings</button>
    </div>
  </div>
</header>
<div id="subnav"><div class="subnavInner"><div id="crumbs">Home</div><div class="saveState" id="saveState">Saved locally</div></div></div>

<main id="app"></main>

<footer class="footer">
  <div class="footerInner">
    <div><strong>ClassTask</strong> v0.2.0 Beta · Educational assignment workspace · Browser-local by default.</div>
    <div class="footerLinks">
      <a href="#" onclick="go('whatsnew');return false">What's New</a>
      <a href="#" onclick="showLegal('terms');return false">Terms of Service</a>
      <a href="#" onclick="showLegal('privacy');return false">Privacy Policy</a>
      <a href="#" onclick="showAbout();return false">About</a>
    </div>
  </div>
</footer>
<div id="toast"></div>
<div id="modalRoot"></div>

<script>
"use strict";

const VERSION = "0.2.0";
const STORE_KEY = "classtask-v020-state";
const OLD_STORE_KEY = "classtask-v010-state";
const nowISO = () => new Date().toISOString();
const uid = (p="id") => p+"_"+Date.now().toString(36)+"_"+Math.random().toString(36).slice(2,8);
const esc = s => String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const strip = html => {const d=document.createElement("div");d.innerHTML=html||"";return d.textContent||""};
const clamp=(n,a,b)=>Math.max(a,Math.min(b,n));
const fmtDate = v => {
  if(!v) return "No deadline";
  const d=new Date(v); return isNaN(d) ? v : d.toLocaleString([], {year:"numeric",month:"short",day:"numeric",hour:"numeric",minute:"2-digit"});
};
const fmtDuration = sec => {
  sec=Math.max(0,Math.round(Number(sec)||0));
  const h=Math.floor(sec/3600),m=Math.floor((sec%3600)/60),s=sec%60;
  return h?`${h}h ${m}m ${s}s`:m?`${m}m ${s}s`:`${s}s`;
};
let saveTimer=null;
let route="dashboard";
let routeData={};
let timerTick=null;
let state = loadState();

function seedState(){
  const cls={id:"class_demo",name:"Science 8",period:"Period 2",joinCode:"SCI8A",archived:false};
  const unit={id:"unit_demo",classId:cls.id,name:"Unit 1: Scientific Method",description:"Observation, variables, evidence, and conclusions.",order:1};
  const makeBlock=(type,data={})=>Object.assign({id:uid("b"),type,points:type==="reading"?0:1,weight:1,required:type!=="reading"},data);
  const a1={
    id:"asn_demo",classId:cls.id,classIds:[cls.id],unitId:unit.id,title:"Scientific Method Check-In",
    description:"A short knowledge check covering variables, fair tests, and basic experiment planning.",
    instructions:"Complete each page. You may use your class notes. Submit before the deadline.",
    category:"Quiz",status:"published",createdAt:nowISO(),updatedAt:nowISO(),
    dueAt:new Date(Date.now()+3*86400000).toISOString().slice(0,16),
    settings:{attempts:2,shuffleQuestions:false,shuffleChoices:false,releaseMode:"immediate",showCorrect:true,showFeedback:true,allowLate:true,tts:true,requireAll:true,timerMinutes:12,navigation:"sequential",gradingMode:"autograde",aiChecker:true,showPublicComments:true,testMode:false,fullscreenRequired:true,lockOnFullscreenExit:true},
    blocks:[
      makeBlock("reading",{title:"Reading: Variables",text:"An independent variable is the factor changed by the investigator. A dependent variable is what is measured. Controlled variables are kept the same so the comparison is fair."}),
      makeBlock("multiple",{prompt:"Which variable is measured as the result of a change?",choices:["Independent variable","Dependent variable","Controlled variable","Random variable"],answer:1,points:2}),
      makeBlock("checkbox",{prompt:"Select all examples of controlled variables in a plant-growth experiment.",choices:["Same soil amount","Same pot size","Different light amount","Same water schedule"],answers:[0,1,3],points:3,weight:1.25}),
      makeBlock("short",{prompt:"In one or two sentences, explain why controlled variables are useful.",points:3,teacherKey:"They help make the test fair and isolate the independent variable."}),
      makeBlock("long",{prompt:"Describe a simple experiment you could perform at home or school. Identify the independent and dependent variables.",points:4,teacherKey:"Open response."})
    ]
  };
  const a2={
    id:"asn_demo2",classId:cls.id,classIds:[cls.id],unitId:unit.id,title:"Experiment Planning Mini Task",
    description:"Plan an investigation and identify variables before the lab day.",
    instructions:"Read the prompt and write a concise plan.",category:"Assignment",status:"published",createdAt:nowISO(),updatedAt:nowISO(),
    dueAt:new Date(Date.now()+6*86400000).toISOString().slice(0,16),
    settings:{attempts:1,shuffleQuestions:false,shuffleChoices:false,releaseMode:"teacher",showCorrect:false,showFeedback:true,allowLate:true,tts:false,requireAll:true,timerMinutes:0,navigation:"sequential",gradingMode:"manualgrade",aiChecker:false,showPublicComments:true,testMode:false,fullscreenRequired:true,lockOnFullscreenExit:true},
    blocks:[
      makeBlock("long",{prompt:"Plan a fair test comparing two paper-airplane designs. State what you will change, measure, and keep the same.",points:10,weight:1})
    ]
  };
  return {
    role:"teacher",
    profile:{teacherName:"Teacher",studentName:"Demo Student",studentId:"student_demo",classIds:[cls.id]},
    people:[{id:"student_demo",name:"Demo Student",firstSeen:nowISO(),lastSeen:nowISO(),visits:1}],
    classes:[cls],units:[unit],assignments:[a1,a2],submissions:[],
    publicComments:[{id:uid("com"),assignmentId:a1.id,author:"Teacher",role:"teacher",text:"Remember: a fair test changes only one main variable at a time.",time:nowISO(),visible:true}],
    privateComments:[],
    commands:[{id:uid("cmd"),scope:"all",targetId:"",assignmentId:a1.id,title:"Class reminder",text:"Use complete sentences for written responses.",time:nowISO(),active:true}],
    settings:{compact:false,autosave:true,confirmDelete:true,dateFormat:"local",sound:false},
    cloud:{provider:"supabase",projectUrl:"",anonKey:"",table:"classtask_assignments"},
    activity:[{id:uid("act"),time:nowISO(),text:"ClassTask v0.2.0 Beta workspace created."}]
  };
}
function migrateState(s){
  const base=seedState();
  s=Object.assign(base,s||{});
  s.profile=Object.assign(base.profile,s.profile||{});
  s.settings=Object.assign(base.settings,s.settings||{});
  s.cloud=Object.assign(base.cloud,s.cloud||{});
  s.profile.classIds=Array.isArray(s.profile.classIds)?s.profile.classIds:[...(s.classes||[]).map(c=>c.id)];
  s.people=Array.isArray(s.people)?s.people:[];
  if(!s.people.some(p=>p.id===s.profile.studentId))s.people.push({id:s.profile.studentId,name:s.profile.studentName,firstSeen:nowISO(),lastSeen:nowISO(),visits:1});
  s.publicComments=Array.isArray(s.publicComments)?s.publicComments:[];
  s.privateComments=Array.isArray(s.privateComments)?s.privateComments:[];
  s.commands=Array.isArray(s.commands)?s.commands:[];
  s.assignments=(s.assignments||[]).map(a=>{
    a.description=a.description||"";
    a.category=a.category||"Assignment";
    a.classIds=Array.isArray(a.classIds)&&a.classIds.length?a.classIds.slice():[a.classId].filter(Boolean);
