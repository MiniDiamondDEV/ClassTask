function saveGeneralSettings(){
  state.settings.autosave=document.getElementById("g_autosave").checked;state.settings.confirmDelete=document.getElementById("g_confirm").checked;
  state.profile.teacherName=document.getElementById("g_teacher").value.trim()||"Teacher";state.profile.studentName=document.getElementById("g_student").value.trim()||"Student";state.profile.studentId=document.getElementById("g_studentid").value.trim()||uid("student");
  touchPerson();saveState();toast("Settings saved.");
}
function saveCloudSettings(){
  state.cloud.projectUrl=document.getElementById("cloud_url").value.trim().replace(/\/$/,"");state.cloud.anonKey=document.getElementById("cloud_key").value.trim();state.cloud.table=(document.getElementById("cloud_table").value.trim()||"classtask_assignments").replace(/[^a-zA-Z0-9_]/g,"");saveState();toast("Cloud settings saved.");
}
async function cloudRequest(path,options={}){
  const c=state.cloud;if(!c.projectUrl||!c.anonKey)throw new Error("Configure the cloud project URL and public key first.");
  const headers=Object.assign({"apikey":c.anonKey,"Authorization":"Bearer "+c.anonKey,"Content-Type":"application/json","Accept":"application/json"},options.headers||{});
  const res=await fetch(c.projectUrl+"/rest/v1/"+path,Object.assign({},options,{headers}));if(!res.ok)throw new Error(`Cloud request failed (${res.status}): ${await res.text()}`);
  const txt=await res.text();return txt?JSON.parse(txt):null;
}
async function testCloud(){saveCloudSettings();try{await cloudRequest(`${state.cloud.table}?select=id&limit=1`);toast("Cloud connection succeeded.")}catch(e){showModal("Cloud Test",`<div class="error">${esc(e.message)}</div><div class="muted">Make sure the table exists and its read policy permits the public key.</div>`,`<button class="btn" onclick="closeModal()">Close</button>`)}}
async function cloudPublish(id){
  const a=findAssignment(id);if(!a)return;
  try{const payload={id:a.id,updated_at:nowISO(),payload:{assignment:a,classInfo:state.classes.find(c=>c.id===a.classId)||null,classInfos:state.classes.filter(c=>assignmentClassIds(a).includes(c.id)),unitInfo:state.units.find(u=>u.id===a.unitId)||null,comments:state.publicComments.filter(c=>c.assignmentId===a.id&&c.visible)}};await cloudRequest(state.cloud.table,{method:"POST",headers:{"Prefer":"resolution=merge-duplicates,return=representation"},body:JSON.stringify(payload)});const link=location.href.split("#")[0]+"#cloud="+encodeURIComponent(a.id);const ta=document.getElementById("shareLink");if(ta)ta.value=link;toast("Assignment published to configured cloud.")}catch(e){showModal("Cloud Publish Error",`<div class="error">${esc(e.message)}</div>`,`<button class="btn" onclick="closeModal()">Close</button>`)}
}
async function importCloudHash(){
  if(!location.hash.startsWith("#cloud="))return;const id=decodeURIComponent(location.hash.slice(7));
  try{const rows=await cloudRequest(`${state.cloud.table}?id=eq.${encodeURIComponent(id)}&select=payload`),p=rows?.[0]?.payload;if(!p?.assignment)throw new Error("Shared assignment not found.");if(!state.assignments.some(a=>a.id===p.assignment.id))state.assignments.push(p.assignment);if(p.classInfo&&!state.classes.some(c=>c.id===p.classInfo.id))state.classes.push(p.classInfo);(p.classInfos||[]).forEach(c=>{if(!state.classes.some(x=>x.id===c.id))state.classes.push(c)});if(p.unitInfo&&!state.units.some(u=>u.id===p.unitInfo.id))state.units.push(p.unitInfo);(p.comments||[]).forEach(c=>{if(!state.publicComments.some(x=>x.id===c.id))state.publicComments.push(c)});state.profile.classIds=[...new Set([...(state.profile.classIds||[]),...assignmentClassIds(p.assignment)])];state.role="student";saveState();history.replaceState(null,"",location.href.split("#")[0]);go("take",{id:p.assignment.id,page:-1})}catch(e){showModal("Cloud Share Error",`<div class="error">${esc(e.message)}</div>`,`<button class="btn" onclick="closeModal()">Close</button>`)}
}
function exportData(){const blob=new Blob([JSON.stringify(state,null,2)],{type:"application/json"}),a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download="classtask-v0.2.0-backup.json";a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000)}
function importData(file){if(!file)return;const r=new FileReader();r.onload=()=>{try{state=migrateState(JSON.parse(r.result));saveState();render();toast("Backup imported.")}catch(e){toast("That file is not a valid backup.")}};r.readAsText(file)}
function resetDemo(){if(!confirm("Reset all local ClassTask data to the v0.2.0 Beta demo?"))return;localStorage.removeItem(STORE_KEY);state=seedState();saveState();route="dashboard";render()}

