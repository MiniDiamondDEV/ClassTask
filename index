<style>
*{box-sizing:border-box}
html,body{margin:0;padding:0;background:#e9edf1;color:#222;font-family:Arial,Helvetica,sans-serif;font-size:14px}
body{min-width:320px}
a{color:#174f80;text-decoration:none}
a:hover{text-decoration:underline}
button,input,select,textarea{font-family:Arial,Helvetica,sans-serif;font-size:14px}
button{cursor:pointer}
.material-icons{font-size:17px;vertical-align:-3px;line-height:1}
#siteHeader{background:#2d5d8a;border-bottom:1px solid #173d60;color:#fff;box-shadow:0 1px 4px rgba(0,0,0,.25)}
.headerInner{max-width:1220px;margin:0 auto;display:flex;align-items:center;min-height:56px;padding:0 12px}
.brand{display:flex;align-items:center;font-weight:bold;font-size:22px;color:#fff;text-decoration:none;margin-right:20px}
