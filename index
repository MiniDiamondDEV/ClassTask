.pill.purple{background:#eee7f7;border-color:#b9a3d0}
.empty{padding:24px;text-align:center;border:1px dashed #bbb;background:#fafafa;color:#777}
hr{border:0;border-top:1px solid #ddd;margin:16px 0}
.notice{border:1px solid #d4c170;background:#fff9dc;padding:10px;margin-bottom:12px}
.info{border:1px solid #a9c3d6;background:#eef6fb;padding:10px;margin-bottom:12px}
.error{border:1px solid #d39a95;background:#fff0ef;padding:10px;margin-bottom:12px;color:#842b25}
.successBox{border:1px solid #93bd88;background:#eef8eb;padding:10px;margin-bottom:12px;color:#2e5f25}
.builderTop{display:grid;grid-template-columns:minmax(0,1fr) 280px;gap:14px}
.builderCanvas{border:1px solid #aaa;background:#f6f6f6;padding:12px;min-height:300px}
.builderHelp{border:1px solid #bbb;background:#fff;padding:10px}
.blockCard{border:1px solid #bdbdbd;background:#fff;margin-bottom:10px}
.blockCardHead{background:#e8edf1;border-bottom:1px solid #c2c2c2;padding:7px 9px;display:flex;align-items:center;gap:7px}
.blockCardHead strong{margin-right:auto}
.blockCardBody{padding:10px}
.optionRow{display:grid;grid-template-columns:28px 1fr 70px;gap:6px;align-items:center;margin-bottom:6px}
.dragHandle{font-size:16px;color:#777}
.choiceList{margin:8px 0}
.choiceLine{display:flex;align-items:flex-start;gap:7px;margin:7px 0}
